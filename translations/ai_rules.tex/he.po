#.  !TeX spellcheck = en_US
#. type: Plain text
#: sections/ai_rules.tex:3
msgid "\\addsection{AI rules}{\\skills/armorer.png}"
msgstr ""
"\\addsection{\\texthebrew{חוקי \\textenglish{AI}}}{\\skills/armorer.png}"

#. type: multicols*
#: sections/ai_rules.tex:6
#, no-wrap
msgid ""
"{2}\n"
"  AI rules apply to Enemy Heroes and all Combat encounters, including those against Neutral Units, in \\textbf{Solo Campaigns} and \\textbf{Cooperative} Scenarios.\n"
"\n"
msgstr ""
"{2}\n"
"  חוקי ה-\\textenglish{AI} חלים על גיבורי אויב ועל כל הקרבות, כולל קרבות נגד יחידות נייטרליות, ב\\textbf{קמפיינים לשחקן יחיד} ובתרחישים \\textbf{שיתופיים}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:11
#, no-wrap
msgid ""
"  \\bigskip\n"
"  \\pagetarget{AI Units}{\\subheader{Combat against AI}}\\index{Combat}\n"
"  Foreword: these rules are intended to make fun challenging encounters, but still be simple enough to follow.\n"
"  You will likely find some loopholes which make the encounter too easy, but you may make AI behave more intellegently.\n"
"\n"
msgstr ""
"  \\bigskip\n"
"  \\pagetarget{AI Units}{\\subheader{קרב נגד \\textenglish{AI}}}\\index{קרב}\n"
"  הקדמה: החוקים האלה נועדו ליצור קרבות מאתגרים ומהנים, שעדיין פשוטים מספיק לביצוע.\n"
"  סביר שתמצאו פרצות שהופכות את הקרב לקל מדי, אבל אתם רשאים לגרום ל-\\textenglish{AI} לפעול בתבונה רבה יותר.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:13
#, no-wrap
msgid ""
"  The rules for AI unit placement during setup are described in \\pagelink{CombatAISetup}{Combat section}.\n"
"\n"
msgstr ""
"  החוקים להצבת יחידות ה-\\textenglish{AI} במהלך ההכנה מופיעים ב\\pagelink{CombatAISetup}{פרק הקרב}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:15
#, no-wrap
msgid ""
"  When Neutral enemies or \\pagelink{AI Heroes}{AI Heroes} activate a unit, they follow a set of instructions:\\par\n"
"\n"
msgstr ""
"  כשיחידות אויב נייטרליות או \\pagelink{AI Heroes}{גיבורי \\textenglish{AI}} מפעילים יחידה, הם פועלים לפי ההוראות הבאות:\\par\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:18
#, no-wrap
msgid ""
"  \\begin{itemize}\n"
"    \\item If it is an AI Hero, draw and resolve the next \\pagelink{AI Deck}{AI card}.\n"
"\n"
msgstr ""
"  \\begin{itemize}\n"
"    \\item אם מדובר בגיבור \\textenglish{AI}, שלפו את \\pagelink{AI Deck}{קלף ה-\\textenglish{AI}} הבא והפעילו אותו.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:21
#, no-wrap
msgid ""
"    \\item Enemy Ground \\svg{unit_ground}\\index{Ground Units} and Flying \\svg{unit_flying} units\\index{Flying Units} prioritize attacking units of the \\textbf{same} tier.\n"
"    If this is impossible, they attack the unit of a lower tier (in tier \\textbf{descending} order, down to bronze), and if that is also impossible, they attack the unit of a higher tier (in tier \\textbf{ascending} order).\\par\n"
"\n"
msgstr ""
"    \\item יחידות קרקע \\svg{unit_ground}\\index{יחידות קרקע} ויחידות מעופפות \\svg{unit_flying}\\index{יחידות מעופפות} של האויב תוקפות קודם יחידות מאותה דרגה \\textbf{בדיוק}.\n"
"    אם אין כאלה, הן תוקפות יחידה מדרגה נמוכה יותר (בסדר דרגות \\textbf{יורד}, עד דרגת ארד), ואם גם זה לא אפשרי, הן תוקפות יחידה מדרגה גבוהה יותר (בסדר דרגות \\textbf{עולה}).\\par\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:25
#, no-wrap
msgid ""
"    \\begin{expansion}{navalbattles}\n"
"      If your army includes \\pagelink{Creature Banks Rules}{Creature Bank Units}, enemy units prioritize attacking all other units first, and Creature Bank Units last.\n"
"    \\end{expansion}\n"
"\n"
msgstr ""
"    \\begin{expansion}{navalbattles}\n"
"      אם הצבא שלכם כולל \\pagelink{Creature Banks Rules}{יחידות של מאגרי יצורים}, יחידות האויב תוקפות קודם את כל שאר היחידות, ואת יחידות מאגרי היצורים אחרונות.\n"
"    \\end{expansion}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:32
#, no-wrap
msgid ""
"    \\textit{Example: \\svg{golden}\\svg{unit_ground} has this priority:\n"
"    \\svg{golden}\n"
"    - \\svg{silver}\n"
"    - \\svg{bronze}\n"
"    - \\svg{azure}\n"
"    - Creature Bank Units.}\n"
"\n"
msgstr ""
"    \\textit{לדוגמה: סדר העדיפויות של \\svg{golden}\\svg{unit_ground} הוא:\n"
"    \\svg{golden}\n"
"    - \\svg{silver}\n"
"    - \\svg{bronze}\n"
"    - \\svg{azure}\n"
"    - יחידות של מאגרי יצורים.}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:35
#, no-wrap
msgid ""
"    \\item Ranged \\svg{unit_ranged} units\\index{Ranged Units} prioritize attacking other Ranged \\svg{unit_ranged} units of the same tier, then lower tier, and finally higher tier, using the same tier order as above.\n"
"    If there are no Ranged \\svg{unit_ranged} units for them to target, they prioritize Ground \\svg{unit_ground} and Flying \\svg{unit_flying} units in the same tier order.\\par\n"
"\n"
msgstr ""
"    \\item יחידות קשתים \\svg{unit_ranged}\\index{יחידות קשתים} תוקפות קודם יחידות קשתים \\svg{unit_ranged} אחרות מאותה דרגה, אחר כך מדרגה נמוכה יותר, ולבסוף מדרגה גבוהה יותר, באותו סדר דרגות כמו למעלה.\n"
"    אם אין יחידות קשתים \\svg{unit_ranged} שאפשר לתקוף, הן תוקפות יחידות קרקע \\svg{unit_ground} ויחידות מעופפות \\svg{unit_flying} באותו סדר דרגות.\\par\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:48
#, no-wrap
msgid ""
"    \\textit{Example: \\svg{silver}\\svg{unit_ranged} has this priority:\n"
"    \\svg{silver}\\svg{unit_ranged}\n"
"    - \\svg{bronze}\\svg{unit_ranged}\n"
"    - \\svg{golden}\\svg{unit_ranged}\n"
"    - \\svg{azure}\\svg{unit_ranged}\n"
"    - Creature Bank Units\\,\\svg{unit_ranged}\n"
"    - \\svg{silver}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - \\svg{bronze}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - \\svg{golden}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - \\svg{azure}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - Creature Bank Units\\,\\svg{unit_ground}\\svg{unit_flying}.}\n"
"  \\end{itemize}\n"
"\n"
msgstr ""
"    \\textit{לדוגמה: סדר העדיפויות של \\svg{silver}\\svg{unit_ranged} הוא:\n"
"    \\svg{silver}\\svg{unit_ranged}\n"
"    - \\svg{bronze}\\svg{unit_ranged}\n"
"    - \\svg{golden}\\svg{unit_ranged}\n"
"    - \\svg{azure}\\svg{unit_ranged}\n"
"    - יחידות של מאגרי יצורים\\,\\svg{unit_ranged}\n"
"    - \\svg{silver}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - \\svg{bronze}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - \\svg{golden}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - \\svg{azure}\\svg{unit_ground}\\svg{unit_flying}\n"
"    - יחידות של מאגרי יצורים\\,\\svg{unit_ground}\\svg{unit_flying}.}\n"
"  \\end{itemize}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:51
#, no-wrap
msgid ""
"  In both cases, if there is more than one valid target, they attack the closest one.\n"
"  If there is ever a tie between equally valid targets, the player chooses which unit is attacked.\\par\n"
"\n"
msgstr ""
"  בשני המקרים, אם יש יותר ממטרה אפשרית אחת, הן תוקפות את הקרובה ביותר.\n"
"  אם יש שוויון בין כמה מטרות אפשריות, השחקן בוחר איזו יחידה מותקפת.\\par\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:58
#, no-wrap
msgid ""
"  \\begin{expansion}{navalbattles}\n"
"    \\pagelink{Creature Banks Rules}{Creature Bank Units} do not have a tier.\n"
"    Therefore, they ignore the tier order in the lists above and instead attack the nearest valid target.\n"
"    % TODO maybe use this, depending on what Robert replies? Therefore, they ignore the tier-based priority list above and instead attack the nearest valid target.\n"
"    % https://boardgamegeek.com/thread/3689848/creature-banks-vs-spells\n"
"  \\end{expansion}\n"
"\n"
msgstr ""
"  \\begin{expansion}{navalbattles}\n"
"    ל\\pagelink{Creature Banks Rules}{יחידות של מאגרי יצורים} אין דרגה.\n"
"    לכן הן מתעלמות מסדר הדרגות ברשימות שלמעלה, ותוקפות את המטרה האפשרית הקרובה ביותר.\n"
"    % TODO maybe use this, depending on what Robert replies? Therefore, they ignore the tier-based priority list above and instead attack the nearest valid target.\n"
"    % https://boardgamegeek.com/thread/3689848/creature-banks-vs-spells\n"
"  \\end{expansion}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:60
#, no-wrap
msgid ""
"  Enemy units cannot \\pagelink{Defend}{defend} unless instructed to.\n"
"\n"
msgstr ""
"  יחידות אויב לא \\pagelink{Defend}{מתגוננות}, אלא אם קיבלו הוראה לעשות זאת.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:65
#, no-wrap
msgid ""
"  \\pagetarget{AI Siege}{\\subsection*{AI Siege}}\\index{Siege Combat}\n"
"  \\textbf{If you are besieging an AI Town:} When the Walls and Gate\\index{Walls and Gate} are mentioned in Combat preparation but no additional information on how to arrange them is given, place the Gate in front of the \\svg{unit_ground} unit with the highest \\svg{initiative}.\n"
"  By default, the units do not attack the Walls -- they would rather fly over them to attack their target or move towards it through the Gate.\n"
"  If neither is possible, they take a \\pagelink{Defend}{Defend} Action.\n"
"\n"
msgstr ""
"  \\pagetarget{AI Siege}{\\subsection*{מצור נגד \\textenglish{AI}}}\\index{קרב מצור}\n"
"  \\textbf{אם אתם צרים על עיר של \\textenglish{AI}:} כשהכנת הקרב מזכירה את החומות והשער\\index{חומות ושער} אבל לא מפרטת איך לסדר אותם, הציבו את השער מול יחידת הקרקע \\svg{unit_ground} עם ה-\\svg{initiative} הגבוהה ביותר.\n"
"  כברירת מחדל, היחידות לא תוקפות את החומות – הן מעדיפות לעוף מעליהן כדי לתקוף את המטרה שלהן, או לנוע אליה דרך השער.\n"
"  אם אף אחת מהאפשרויות לא קיימת, הן מבצעות פעולת \\pagelink{Defend}{התגוננות}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:68
#, no-wrap
msgid ""
"  To the AI, \\pagelink{Walls}{the Arrow Tower}\\index{Arrow Tower} counts as a Silver \\svg{silver}\\svg{unit_ranged} unit.\n"
"  However, if it has multiple equally valid targets to attack, it will attack the one with the least health remaining (the smallest difference between \\svg{health_points} and current~\\svg{damage}).\n"
"\n"
msgstr ""
"  מבחינת ה-\\textenglish{AI}, \\pagelink{Walls}{מגדל החצים}\\index{מגדל חצים} נחשב ליחידת קשתים מדרגת כסף \\svg{silver}\\svg{unit_ranged}.\n"
"  עם זאת, אם יש לו כמה מטרות אפשריות שוות, הוא תוקף את זו שנשארו לה הכי מעט נקודות חיים (ההפרש הקטן ביותר בין \\svg{health_points} ל-\\svg{damage} הנוכחי).\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:72
#, no-wrap
msgid ""
"  \\textbf{If AI Hero besieges you}, the Arrow Tower counts as a Silver \\svg{silver}\\svg{unit_ranged} unit as well.\n"
"  Furthermore, \\svg{unit_ground} and \\svg{unit_flying} units attack the closest wall if no other enemy is in their reach."
msgstr ""
"  \\textbf{אם גיבור \\textenglish{AI} צר עליכם}, גם אז מגדל החצים נחשב ליחידת קשתים מדרגת כסף \\svg{silver}\\svg{unit_ranged}.\n"
"  בנוסף, יחידות \\svg{unit_ground} ו-\\svg{unit_flying} תוקפות את החומה הקרובה ביותר אם אין אויב אחר בהישג ידן."

#. type: multicols
#: sections/ai_rules.tex:80
#, no-wrap
msgid ""
"{2}\n"
"  \\pagetarget{AI Heroes}{\\subheader{AI Heroes}}\n"
"  AI Heroes are used in Campaigns.\n"
"  AI Heroes do not have a Town Board, Resources, or a Hero Board.\n"
"  Their units are static and defined by the Scenario: locate the indicated unit cards during setup.\n"
"  If the unit indicates a unit tier (\\svg{bronze}, \\svg{silver}, \\svg{golden}, or \\svg{azure}) instead of ``Few'' or ``Pack'', it is a Neutral Unit.\n"
"\n"
msgstr ""
"{2}\n"
"  \\pagetarget{AI Heroes}{\\subheader{גיבורי \\textenglish{AI}}}\n"
"  משחקים עם גיבורי \\textenglish{AI} בקמפיינים.\n"
"  לגיבורי \\textenglish{AI} אין לוח עיר, משאבים או לוח גיבור.\n"
"  היחידות שלהם קבועות, והתרחיש קובע אותן: אתרו את קלפי היחידות המצוינים במהלך ההכנה.\n"
"  אם התרחיש מציין ליחידה דרגה (\\svg{bronze}, \\svg{silver}, \\svg{golden} או \\svg{azure}) במקום ״מעטים״ או ״רבים״, זו יחידה נייטרלית.\n"
"\n"

#. type: multicols
#: sections/ai_rules.tex:83
#, no-wrap
msgid ""
"  During setup, if multiple AI Heroes use the same unit and you do not have enough copies of its card, the AI Heroes must share it:\n"
"  set up everything without that card, then add it to the AI Hero's Army when you initiate Combat with them.\n"
"\n"
msgstr ""
"  אם במהלך ההכנה כמה גיבורי \\textenglish{AI} משתמשים באותה יחידה ואין לכם מספיק עותקים של הקלף שלה, גיבורי ה-\\textenglish{AI} חולקים אותו:\n"
"  הכינו את כל השאר בלי הקלף הזה, והוסיפו אותו לצבא של גיבור ה-\\textenglish{AI} כשאתם פותחים נגדו בקרב.\n"
"\n"

#. type: multicols
#: sections/ai_rules.tex:87
#, no-wrap
msgid ""
"  AI Heroes cannot surrender and you cannot surrender to them;\n"
"  they will always fight until they run out of units.\n"
"  Winning Combat against an AI Hero does not grant any rewards unless stated by the Scenario.\n"
"\n"
msgstr ""
"  גיבורי \\textenglish{AI} לא יכולים להיכנע, וגם אתם לא יכולים להיכנע להם;\n"
"  הם תמיד נלחמים עד שנגמרות להם היחידות.\n"
"  ניצחון בקרב נגד גיבור \\textenglish{AI} לא מעניק שום פרס, אלא אם התרחיש קובע אחרת.\n"
"\n"

#. type: multicols
#: sections/ai_rules.tex:97
#, no-wrap
msgid ""
"  \\columnbreak\n"
"  \\subsection*{AI Hero Turns}\n"
"  Unless specified otherwise, AI Heroes start in their Town, take turns after the player, and have 3 MP, always spending them to perform the following actions in descending priority:\n"
"  \\begin{itemize}\n"
"    \\item If a player's Hero is on the same Tile as the AI, spend all MP to move towards them in an attempt to start Combat.\n"
"    \\item If there are any Mines or Settlements the AI could flag on the same Tile, move towards the closest one.\n"
"    \\item Otherwise, move toward the player's Town.\n"
"  \\end{itemize}\n"
"  Repeat this sequence until all MPs are used up.\n"
"\n"
msgstr ""
"  \\columnbreak\n"
"  \\subsection*{התור של גיבורי \\textenglish{AI}}\n"
"  אלא אם נאמר אחרת, גיבורי \\textenglish{AI} מתחילים בעיר שלהם, משחקים את התור שלהם אחרי השחקן, ויש להם 3 נקודות תנועה. הם תמיד מנצלים אותן לפעולות הבאות, לפי סדר העדיפות:\n"
"  \\begin{itemize}\n"
"    \\item אם גיבור של שחקן נמצא על אותו אריח כמו גיבור ה-\\textenglish{AI}, הוא מנצל את כל נקודות התנועה כדי לנוע לעברו ולנסות לפתוח בקרב.\n"
"    \\item אם יש על אותו אריח מכרות או יישובים שגיבור ה-\\textenglish{AI} יכול לכבוש, הוא נע לעבר הקרוב ביותר.\n"
"    \\item אחרת, הוא נע לעבר העיר של השחקן.\n"
"  \\end{itemize}\n"
"  חזרו על הרצף הזה עד שגיבור ה-\\textenglish{AI} מנצל את כל נקודות התנועה.\n"
"\n"

#. type: multicols
#: sections/ai_rules.tex:100
#, no-wrap
msgid ""
"  AI Heroes always \\textbf{automatically win Combat} against any Neutral Units, while simultaneously \\textbf{flagging or visiting all Fields} they happen to move through.\n"
"  They gain no benefits from any Fields.\n"
"\n"
msgstr ""
"  גיבורי \\textenglish{AI} תמיד \\textbf{מנצחים אוטומטית בקרב} נגד יחידות נייטרליות, ובאותו זמן \\textbf{כובשים את כל השדות שהם עוברים בהם, או מבקרים בהם}.\n"
"  הם לא מקבלים שום תועלת מהשדות.\n"
"\n"

#. type: multicols
#: sections/ai_rules.tex:103
#, no-wrap
msgid ""
"  AI Heroes must discover face down Map Tiles as normal by spending 1 MP before moving onto them.\n"
"  The player chooses that Tile's orientation."
msgstr ""
"  גיבורי \\textenglish{AI} חייבים לגלות אריחי מפה הפוכים כרגיל, ולהוציא נקודת תנועה אחת לפני שהם נכנסים אליהם.\n"
"  השחקן בוחר את הכיוון של האריח."

#. type: Plain text
#: sections/ai_rules.tex:109
msgid ""
"{\\begin{center} \\vfill \\includegraphics[width=\\linewidth]{\\art/"
"gold_dragon.jpg} \\end{center}}"
msgstr ""
"{\\begin{center} \\vfill \\includegraphics[width=\\linewidth]{\\art/"
"gold_dragon.jpg} \\end{center}}"

#. type: multicols*
#: sections/ai_rules.tex:113
#, no-wrap
msgid ""
"{2}\n"
"  \\pagetarget{AI Deck}{\\subheader{AI Decks}}\n"
"  \\begin{tikzpicture}\n"
msgstr ""
"{2}\n"
"  \\pagetarget{AI Deck}{\\subheader{חפיסות ה-\\textenglish{AI}}}\n"
"  \\begin{tikzpicture}\n"

#. type: multicols*
#: sections/ai_rules.tex:145
#, no-wrap
msgid ""
"    \\node (card) {\\includegraphics[width=0.57\\linewidth]{\\cards/ai.png}};\n"
"    \\begin{relcoords}{card}\n"
"      \\draw (0.4, 0.85) node {\\encircle{1}};\n"
"      \\draw (0.8, 0.7) node {\\encircle{2}};\n"
"      \\draw (0.15, 0.5) node {\\encircle{3}};\n"
"      \\draw (0.55, 0.5) node {\\encircle{4}};\n"
"      \\draw (0.15, 0.3) node {\\encircle{5}};\n"
"      \\draw (0.55, 0.3) node {\\encircle{6}};\n"
"      \\draw (0.4, 0.1) node {\\encircle{7}};\n"
"    \\end{relcoords}\n"
"    \\node [below=0pt of card.south] {\\imagecaption{AI card}};\n"
"    \\node [right=-1em of card.east] {\n"
"      \\begin{minipage}[t]{0.43\\linewidth}\n"
"        \\scriptsize\n"
"        \\begin{itemize}[itemsep=0.8em]\n"
"          \\item[\\textbf{1.}] Name\n"
"          \\item[\\textbf{2.}] Description\n"
"          \\item[\\textbf{3.}] Easy Modifier\n"
"          \\item[\\textbf{4.}] Normal Modifier\n"
"          \\item[\\textbf{5.}] Expert Modifier\n"
"          \\item[\\textbf{6.}] Impossible\\\\Modifier\n"
"          \\item[\\textbf{7.}] Card Type:\\\\\n"
"            \\begin{itemize}[itemsep=0.5em]\n"
"              \\item[{\\svg[12]{might}}] Might\n"
"              \\item[\\svg{magic}] Magic\n"
"              \\item[\\svg{skill}] Skill\n"
"            \\end{itemize}\n"
"        \\end{itemize}\n"
"      \\end{minipage}\n"
"    };\n"
"  \\end{tikzpicture}\n"
"\n"
msgstr ""
"    \\node (card) {\\includegraphics[width=0.57\\linewidth]{\\cards/ai.png}};\n"
"    \\begin{relcoords}{card}\n"
"      \\draw (0.4, 0.85) node {\\encircle{1}};\n"
"      \\draw (0.8, 0.7) node {\\encircle{2}};\n"
"      \\draw (0.15, 0.5) node {\\encircle{3}};\n"
"      \\draw (0.55, 0.5) node {\\encircle{4}};\n"
"      \\draw (0.15, 0.3) node {\\encircle{5}};\n"
"      \\draw (0.55, 0.3) node {\\encircle{6}};\n"
"      \\draw (0.4, 0.1) node {\\encircle{7}};\n"
"    \\end{relcoords}\n"
"    \\node [below=0pt of card.south] {\\imagecaption{קלף \\textenglish{AI}}};\n"
"    \\node [right=-1em of card.east] {\n"
"      \\begin{minipage}[t]{0.43\\linewidth}\n"
"        \\scriptsize\n"
"        \\begin{itemize}[itemsep=0.8em]\n"
"          \\item[\\textbf{1.}] שם\n"
"          \\item[\\textbf{2.}] תיאור\n"
"          \\item[\\textbf{3.}] שינוי ברמה קלה\n"
"          \\item[\\textbf{4.}] שינוי ברמה רגילה\n"
"          \\item[\\textbf{5.}] שינוי ברמת מומחה\n"
"          \\item[\\textbf{6.}] שינוי ברמה\\\\בלתי אפשרית\n"
"          \\item[\\textbf{7.}] סוג הקלף:\\\\\n"
"            \\begin{itemize}[itemsep=0.5em]\n"
"              \\item[{\\svg[12]{might}}] כוח\n"
"              \\item[\\svg{magic}] קסם\n"
"              \\item[\\svg{skill}] מיומנות\n"
"            \\end{itemize}\n"
"        \\end{itemize}\n"
"      \\end{minipage}\n"
"    };\n"
"  \\end{tikzpicture}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:151
#, no-wrap
msgid ""
"  AI Heroes use two Decks during Combat: the \\textbf{AI Deck} and the \\textbf{AI Spell Deck}.\n"
"  The AI Deck consists of three types of AI cards: Might \\svg[12]{might}, Magic \\svg{magic}, and Skill \\svg{skill}.\n"
"  Each Campaign Scenario lists the number and types of cards to include during setup.\n"
"  Choose these cards \\textbf{randomly} when building the AI Deck.\n"
"  Before each Combat, shuffle the AI Deck and its discard pile together.\n"
"\n"
msgstr ""
"  בקרב, גיבורי \\textenglish{AI} משתמשים בשתי חפיסות: \\textbf{חפיסת ה-\\textenglish{AI}} ו\\textbf{חפיסת הקסמים של ה-\\textenglish{AI}}.\n"
"  חפיסת ה-\\textenglish{AI} מורכבת משלושה סוגים של קלפי \\textenglish{AI}: כוח \\svg[12]{might}, קסם \\svg{magic} ומיומנות \\svg{skill}.\n"
"  כל תרחיש קמפיין מפרט כמה קלפים מכל סוג לכלול בהכנה.\n"
"  בחרו את הקלפים האלה \\textbf{באקראי} כשאתם בונים את חפיסת ה-\\textenglish{AI}.\n"
"  לפני כל קרב, ערבבו יחד את חפיסת ה-\\textenglish{AI} ואת ערימת ההשלכה שלה.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:156
#, no-wrap
msgid ""
"  When an AI Hero \\textbf{activates} a unit, draw an AI card\\index{AI card} and follow its instructions before the unit \\pagelink{AI Units}{moves and/or attacks}.\n"
"  If the AI Deck is depleted during Combat, stop drawing from it.\n"
"  The effect of each AI card depends on the game's \\pagelink{Difficulty}{Difficulty}.\n"
"  If an AI Hero is instructed to draw a card, they will draw and resolve \\textbf{another card} from the AI Deck.\n"
"\n"
msgstr ""
"  כשגיבור \\textenglish{AI} \\textbf{מפעיל} יחידה, שלפו קלף \\textenglish{AI}\\index{קלף \\textenglish{AI}} ובצעו את ההוראות שעליו, לפני שהיחידה \\pagelink{AI Units}{נעה ו/או תוקפת}.\n"
"  אם חפיסת ה-\\textenglish{AI} נגמרת במהלך הקרב, הפסיקו לשלוף ממנה.\n"
"  האפקט של כל קלף \\textenglish{AI} תלוי ב\\pagelink{Difficulty}{רמת הקושי} של המשחק.\n"
"  אם גיבור \\textenglish{AI} מקבל הוראה לשלוף קלף, הוא שולף ומפעיל \\textbf{קלף נוסף} מחפיסת ה-\\textenglish{AI}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:160
#, no-wrap
msgid ""
"  \\subsection*{AI Magic cards and AI Spell Deck}\n"
"  During setup find the Spells indicated in the Scenario and build the \\textbf{AI Spell Deck}.\n"
"  Before each Combat, shuffle the AI Spell Deck and its discard pile together.\n"
"\n"
msgstr ""
"  \\subsection*{קלפי קסם של ה-\\textenglish{AI} וחפיסת הקסמים של ה-\\textenglish{AI}}\n"
"  במהלך ההכנה, אתרו את הקסמים שהתרחיש מציין, ובנו מהם את \\textbf{חפיסת הקסמים של ה-\\textenglish{AI}}.\n"
"  לפני כל קרב, ערבבו יחד את חפיסת הקסמים של ה-\\textenglish{AI} ואת ערימת ההשלכה שלה.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:164
#, no-wrap
msgid ""
"  Whenever an AI Magic \\svg{magic} card is drawn, draw the next Spell from the AI Spell Deck and cast it.\n"
"  Discarded Spells go to its own AI Spell Discard Pile.\n"
"  If the AI Spell Deck empties before Combat ends, shuffle the AI Spell Discard Pile to form a new Spell Deck.\n"
"\n"
msgstr ""
"  בכל פעם שאתם שולפים קלף קסם \\svg{magic} של ה-\\textenglish{AI}, שלפו את הקסם הבא מחפיסת הקסמים של ה-\\textenglish{AI} והטילו אותו.\n"
"  קסמים שהושלכו עוברים לערימת השלכה נפרדת של קסמי ה-\\textenglish{AI}.\n"
"  אם חפיסת הקסמים של ה-\\textenglish{AI} נגמרת לפני סוף הקרב, ערבבו את ערימת ההשלכה של קסמי ה-\\textenglish{AI} ליצירת חפיסת קסמים חדשה.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:168
#, no-wrap
msgid ""
"  The AI Spell Deck may contain more Spell cards than there are Magic cards in the AI Hero's Deck.\n"
"  This is intentional: not all Spells will be used during Combat.\n"
"  Some are included for the sake of variety.\n"
"\n"
msgstr ""
"  חפיסת הקסמים של ה-\\textenglish{AI} עשויה להכיל יותר קלפי קסם ממספר קלפי הקסם שבחפיסה של גיבור ה-\\textenglish{AI}.\n"
"  זה מכוון: לא כל הקסמים ישמשו בקרב.\n"
"  חלקם נמצאים שם כדי לגוון.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:170
#, no-wrap
msgid ""
"  If the AI Hero is assigned a Spell card that is unavailable because it is in your Hero's Deck, and you do not have another copy, substitute it with a \\wikilink{spells/magic_arrow}{Magic Arrow} card.\n"
"\n"
msgstr ""
"  אם התרחיש מקצה לגיבור ה-\\textenglish{AI} קלף קסם שאינו זמין כי הוא בחפיסה של הגיבור שלכם, ואין לכם עותק נוסף, החליפו אותו בקלף \\wikilink{spells/magic_arrow}{\\texthebrew{\\textenglish{Magic Arrow} (חץ קסם)}}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:173
#, no-wrap
msgid ""
"  For certains Spells it can be unclear how the AI is supposed to cast them.\n"
"  See \\pagelink{AI Complex Spells}{Casting Complex Spells} for explanations.\n"
"\n"
msgstr ""
"  לגבי חלק מהקסמים, לא תמיד ברור איך ה-\\textenglish{AI} אמור להטיל אותם.\n"
"  הסברים מופיעים ב\\pagelink{AI Complex Spells}{הטלת קסמים מורכבים}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:179
#, no-wrap
msgid ""
"  \\subsection*{AI Skill cards}\n"
"  If Skill cards are included, search for and set aside the indicated card related to it (usually, an Ability), hereby referred to as ``skill''.\n"
"  Whenever an AI Hero uses the AI Skill \\svg{skill} card, use the skill, but do not discard it afterwards.\n"
"  Contrary to the regular rules, the AI Hero can use the skill again, when instructed to do so by the AI Deck.\n"
"  Discard the AI Skill \\svg{skill} card as usual.\n"
"\n"
msgstr ""
"  \\subsection*{קלפי מיומנות של ה-\\textenglish{AI}}\n"
"  אם התרחיש כולל קלפי מיומנות, חפשו את הקלף שמצוין לצדם (בדרך כלל יכולת) והניחו אותו בצד. מעכשיו נקרא לו ״מיומנות״.\n"
"  בכל פעם שגיבור \\textenglish{AI} משתמש בקלף מיומנות \\svg{skill} של ה-\\textenglish{AI}, השתמשו במיומנות, אבל אל תשליכו אותה אחר כך.\n"
"  בניגוד לחוקים הרגילים, גיבור ה-\\textenglish{AI} יכול להשתמש במיומנות שוב, בכל פעם שחפיסת ה-\\textenglish{AI} מורה לו.\n"
"  את קלף המיומנות \\svg{skill} של ה-\\textenglish{AI} השליכו כרגיל.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:181
#, no-wrap
msgid ""
"  Skills cannot be replaced, so if Scenario rules assign the AI Hero a card that your Hero has and you do not have another copy, remove that card from your Deck and \\textbf{Search (3)} the respective card's Deck to compensate your Hero for the loss.\n"
"\n"
msgstr ""
"  אי אפשר להחליף מיומנויות. לכן, אם חוקי התרחיש מקצים לגיבור ה-\\textenglish{AI} קלף שיש לגיבור שלכם ואין לכם עותק נוסף, הוציאו את הקלף הזה מהחפיסה שלכם ובצעו \\textbf{חיפוש (3)} בחפיסה המתאימה, כדי לפצות את הגיבור שלכם על האובדן.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:184
#, no-wrap
msgid ""
"  \\subsection*{AI cards timing}\n"
"  After an AI card is resolved, discard it.\n"
"\n"
msgstr ""
"  \\subsection*{תזמון קלפי ה-\\textenglish{AI}}\n"
"  אחרי שהפעלתם קלף \\textenglish{AI}, השליכו אותו.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:188
#, no-wrap
msgid ""
"  The \\wikilink{ai\\#ai-cards}{Attack} Might \\svg[12]{might} card says about ``unit that is about to attack'', so if the currently activated unit doesn't have a valid target to attack, the Attack will apply to the next unit who is able to attack.\n"
"  Note that multiple unresolved cards can stack over successive activations.\n"
"  The same applies to any AI card which is not useful at the moment of drawing it.\n"
"\n"
msgstr ""
"  קלף הכוח \\svg[12]{might} \\wikilink{ai\\#ai-cards}{\\texthebrew{\\textenglish{Attack} (התקפה)}} מדבר על ״יחידה שעומדת לתקוף״. לכן, אם ליחידה שמופעלת עכשיו אין מטרה אפשרית לתקוף, ההתקפה חלה על היחידה הבאה שיכולה לתקוף.\n"
"  שימו לב שכמה קלפים שעוד לא הופעלו יכולים להצטבר לאורך כמה הפעלות ברצף.\n"
"  אותו כלל חל על כל קלף \\textenglish{AI} שאינו שימושי ברגע ששלפתם אותו.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:190
#, no-wrap
msgid ""
"  If an AI card increased a unit's \\svg{defense}, or triggered another card which increased it, the AI card stays attached to the unit until the first defense happens.\n"
"\n"
msgstr ""
"  אם קלף \\textenglish{AI} הגדיל את ה-\\svg{defense} של יחידה, או הפעיל קלף אחר שהגדיל אותה, קלף ה-\\textenglish{AI} נשאר צמוד ליחידה עד ההגנה הראשונה שלה.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:193
#, no-wrap
msgid ""
"  \\subsection*{AI Deck sharing}\n"
"  If there are multiple AI Enemy Armies in the Scenario, but the rules do not specify to which Enemy an AI Deck, an AI Spell Deck, or a Skill belongs, you should assume it is shared between them.\n"
"\n"
msgstr ""
"  \\subsection*{חפיסות \\textenglish{AI} משותפות}\n"
"  אם בתרחיש יש כמה צבאות אויב של \\textenglish{AI}, והחוקים לא מציינים לאיזה אויב שייכות חפיסת ה-\\textenglish{AI}, חפיסת הקסמים של ה-\\textenglish{AI} או המיומנות, הניחו שהן משותפות לכולם.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:200
#, no-wrap
msgid ""
"  \\bigskip\n"
"  \\bigskip\n"
"  \\pagetarget{AI Complex Spells}{\\subheader{Casting complex Spells}}\\index{Spell cards}\n"
"  In some Campaigns, enemies use Spells whose effects are not fully compatible with the standard use of AI Magic \\svg{magic} cards.\n"
"  To fully use their effects, here are extended descriptions of how AI Heroes should use each of these Spells.\n"
"  Scenarios can override these instructions.\n"
"\n"
msgstr ""
"  \\bigskip\n"
"  \\bigskip\n"
"  \\pagetarget{AI Complex Spells}{\\subheader{הטלת קסמים מורכבים}}\\index{קלפי קסם}\n"
"  בחלק מהקמפיינים, האויבים משתמשים בקסמים שהאפקטים שלהם לא מתאימים לגמרי לשימוש הרגיל בקלפי קסם \\svg{magic} של ה-\\textenglish{AI}.\n"
"  כדי לנצל את האפקטים האלה במלואם, הנה הסברים מפורטים איך גיבורי \\textenglish{AI} משתמשים בכל אחד מהקסמים האלה.\n"
"  תרחישים יכולים לגבור על ההוראות האלה.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:203
#, no-wrap
msgid ""
"  \\subsection*{Spells attacking multiple targets}\n"
"  \\textit{Examples: \\wikilink{spells/fireball}{Fireball,} \\wikilink{spells/chain_lightning}{Chain Lightning.}}\n"
"\n"
msgstr ""
"  \\subsection*{קסמים שתוקפים כמה מטרות}\n"
"  \\textit{דוגמאות: \\wikilink{spells/fireball}{\\texthebrew{\\textenglish{Fireball} (כדור אש)}}, \\wikilink{spells/chain_lightning}{\\texthebrew{\\textenglish{Chain Lightning} (שרשרת ברקים)}}.}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:209
#, no-wrap
msgid ""
"  When drawn, target any unit with one or two adjacent units from the player's army, prioritizing the groups where there are more higher-tier units.\n"
"  If there is more than one valid group, attack the one with the least health remaining (has the smallest difference between \\svg{health_points} and current \\svg{damage}).\n"
"  If there is still more than one valid target, you can choose which unit is attacked.\n"
"  If there are no player units adjacent to one another, target units that are not adjacent to any of the AI units.\n"
"  If that is also not possible, do not use this Spell -- instead, skip the AI \\svg{magic} card that activated this effect and put it on the bottom of the AI Deck, then shuffle this Spell back to the AI Spell Deck.\n"
"\n"
msgstr ""
"  כששולפים את הקסם, כוונו אותו לכל יחידה מצבא השחקן שיש לצדה יחידה אחת או שתיים סמוכות מאותו צבא, ותנו עדיפות לקבוצות שיש בהן יותר יחידות מדרגה גבוהה.\n"
"  אם יש יותר מקבוצה אפשרית אחת, תקפו את זו שנשארו לה הכי מעט נקודות חיים (ההפרש הקטן ביותר בין \\svg{health_points} ל-\\svg{damage} הנוכחי).\n"
"  אם עדיין יש יותר ממטרה אפשרית אחת, אתם בוחרים איזו יחידה מותקפת.\n"
"  אם אין יחידות של השחקן שסמוכות זו לזו, כוונו ליחידות שלא סמוכות לאף יחידה של ה-\\textenglish{AI}.\n"
"  אם גם זה לא אפשרי, אל תשתמשו בקסם הזה – במקום זאת, דלגו על קלף ה-\\textenglish{AI} \\svg{magic} שהפעיל את האפקט, הניחו אותו בתחתית חפיסת ה-\\textenglish{AI}, וערבבו את הקסם בחזרה לחפיסת הקסמים של ה-\\textenglish{AI}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:212
#, no-wrap
msgid ""
"  \\subsection*{Instant Defense Spells}\n"
"  \\textit{Example: \\wikilink{spells/stone_skin}{Stone Skin.}}\n"
"\n"
msgstr ""
"  \\subsection*{קסמי הגנה מיידיים}\n"
"  \\textit{דוגמה: \\wikilink{spells/stone_skin}{\\texthebrew{\\textenglish{Stone Skin} (עור אבן)}}.}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:216
#, no-wrap
msgid ""
"  When drawn, put this card on the side of the Combat Board, then put a Defense Token on the unit with the highest \\svg{defense} to represent the card's effect -- it stays there until the Defense is resolved.\n"
"  If that unit already has a Defense Token, place it on the unit with the next highest \\svg{defense} instead.\n"
"  In case of a tie in \\svg{defense} value, give preference to the unit of the highest tier, then to the greatest value of \\svg{damage}.\n"
"\n"
msgstr ""
"  כששולפים את הקסם, הניחו את הקלף בצד לוח הקרב, והניחו אסימון הגנה על היחידה עם ה-\\svg{defense} הגבוהה ביותר כדי לסמן את האפקט של הקלף – האסימון נשאר שם עד שההגנה מתבצעת.\n"
"  אם כבר יש על היחידה הזו אסימון הגנה, הניחו אותו על היחידה עם ה-\\svg{defense} הגבוהה הבאה.\n"
"  אם יש שוויון בערך ה-\\svg{defense}, העדיפו את היחידה מהדרגה הגבוהה ביותר, ואחר כך את זו עם ערך ה-\\svg{damage} הגבוה ביותר.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:219
#, no-wrap
msgid ""
"  \\subsection*{Healing Spells}\n"
"  \\textit{Example: \\wikilink{spells/cure}{Cure.}}\n"
"\n"
msgstr ""
"  \\subsection*{קסמי ריפוי}\n"
"  \\textit{דוגמה: \\wikilink{spells/cure}{\\texthebrew{\\textenglish{Cure} (ריפוי)}}.}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:222
#, no-wrap
msgid ""
"  When drawn, remove the \\svg{damage} from the AI unit with the greatest value of \\svg{damage} taken, starting with the highest tier available.\n"
"  If no AI unit has any \\svg{damage}, put the AI \\svg{magic} card that triggered the Spell at the bottom of the AI Deck, then shuffle this Spell card back to the AI Spell Deck.\n"
"\n"
msgstr ""
"  כששולפים את הקסם, הסירו את ה-\\svg{damage} מיחידת ה-\\textenglish{AI} שספגה הכי הרבה \\svg{damage}, החל מהדרגה הגבוהה ביותר שיש.\n"
"  אם אף יחידת \\textenglish{AI} לא ספגה \\svg{damage}, הניחו את קלף ה-\\textenglish{AI} \\svg{magic} שהפעיל את הקסם בתחתית חפיסת ה-\\textenglish{AI}, וערבבו את קלף הקסם בחזרה לחפיסת הקסמים של ה-\\textenglish{AI}.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:225
#, no-wrap
msgid ""
"  \\subsection*{Single-round buffs}\n"
"  \\textit{Example: \\wikilink{spells/fire_shield}{Fire Shield.}}\n"
"\n"
msgstr ""
"  \\subsection*{חיזוקים לסבב אחד}\n"
"  \\textit{דוגמה: \\wikilink{spells/fire_shield}{\\texthebrew{\\textenglish{Fire Shield} (מגן אש)}}.}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:229
#, no-wrap
msgid ""
"  When drawn, check the tier of the unit on which you are about to cast the Spell and count how many units of the same or higher tier there are on the Board.\n"
"  If more than half of those units have already activated this Round, do not cast the Spell; instead, set it aside and cast it when the first AI unit activates next Round; skip drawing the AI card for that activation.\n"
"  Multiple delayed Spells may accumulate and be cast during the same activation.\n"
"\n"
msgstr ""
"  כששולפים את הקסם, בדקו את הדרגה של היחידה שעליה אתם עומדים להטיל אותו, וספרו כמה יחידות מאותה דרגה או מדרגה גבוהה יותר יש על הלוח.\n"
"  אם יותר ממחצית היחידות האלה כבר הופעלו בסבב הזה, אל תטילו את הקסם; במקום זאת, הניחו אותו בצד והטילו אותו כשיחידת ה-\\textenglish{AI} הראשונה מופעלת בסבב הבא, ובהפעלה הזו אל תשלפו קלף \\textenglish{AI}.\n"
"  כמה קסמים שנדחו יכולים להצטבר ולהיות מוטלים באותה הפעלה.\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:232
#, no-wrap
msgid ""
"  \\subsection*{Attack-weakening Spells}\n"
"  \\textit{Example: \\wikilink{spells/weakness}{Weakness.}}\n"
"\n"
msgstr ""
"  \\subsection*{קסמים שמחלישים התקפה}\n"
"  \\textit{דוגמה: \\wikilink{spells/weakness}{\\texthebrew{\\textenglish{Weakness} (חולשה)}}.}\n"
"\n"

#. type: multicols*
#: sections/ai_rules.tex:235
#, no-wrap
msgid ""
"  When drawn, if the AI's activated unit is about to perform an attack that will provoke a Retaliation, cast this Spell on the Retaliating enemy to lower their \\svg{attack}.\n"
"  If the AI's unit causes no Retaliation, do not cast this Spell; instead, ignore the AI \\svg{magic} card that activated the Spell and put it at the bottom of the AI Deck, then shuffle the Spell card back to the AI Spell Deck."
msgstr ""
"  כששולפים את הקסם, אם היחידה המופעלת של ה-\\textenglish{AI} עומדת לבצע התקפה שתגרור התקפת נגד, הטילו את הקסם על האויב שמבצע את התקפת הנגד, כדי להוריד את ה-\\svg{attack} שלו.\n"
"  אם היחידה של ה-\\textenglish{AI} לא גוררת התקפת נגד, אל תטילו את הקסם; במקום זאת, התעלמו מקלף ה-\\textenglish{AI} \\svg{magic} שהפעיל את הקסם, הניחו אותו בתחתית חפיסת ה-\\textenglish{AI}, וערבבו את קלף הקסם בחזרה לחפיסת הקסמים של ה-\\textenglish{AI}."
