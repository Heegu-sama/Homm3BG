#. type: Plain text
#: sections/map_elements.tex:190
msgid "\\subheader{Expansion Tiles}"
msgstr "\\subheader{אריחי הרחבות}"

#. type: multicols
#: sections/map_elements.tex:190
#, no-wrap
msgid ""
"{2}\n"
"\\begin{expansion}{cove}\n"
"  \\subsection*{\\pagetarget{Sea Map Tiles}{Sea Map Tiles}}\n"
"  \\index{Sea Map Tile}\n"
"  Sea Map Tiles have a unique backside and during setup are placed as shown in the Scenario Map Layout.\n"
"  Discovering them works as with regular Tiles.\n"
"  Sea Map Tiles may contain both land and sea Fields.\n"
"  Movement from land to land, from sea to sea, or from sea to land works as normal.\n"
"  However, when your Hero \\textbf{enters a sea Field from a land Field}, their movement for the Turn ends.\n"
"  You may use unspent MP for other Actions (for example, to \\pagelink{Timelimit}{extend Combat} against Neutral Units), but you cannot move anymore that Turn, not even with the help of card effects.\n"
"\\end{expansion}\n"
"\n"
msgstr ""
"{2}\n"
"\\begin{expansion}{cove}\n"
"  \\subsection*{\\pagetarget{Sea Map Tiles}{אריחי ים}}\n"
"  \\index{אריח ים}\n"
"  לאריחי ים יש גב ייחודי, ובמהלך ההכנה מניחים אותם כפי שמוצג במתווה המפה של התרחיש.\n"
"  הגילוי שלהם עובד כמו באריחים רגילים.\n"
"  אריחי ים יכולים להכיל גם שדות יבשה וגם שדות ים.\n"
"  תנועה מיבשה ליבשה, מים לים או מים ליבשה מתבצעת כרגיל.\n"
"  אבל כשהגיבור שלכם \\textbf{נכנס לשדה ים משדה יבשה}, התנועה שלו לאותו תור מסתיימת.\n"
"  אתם יכולים להשתמש בנקודות תנועה שנותרו לפעולות אחרות (למשל, כדי \\pagelink{Timelimit}{להאריך קרב} נגד יחידות נייטרליות), אבל לא תוכלו לנוע יותר באותו תור, אפילו לא בעזרת אפקטים של קלפים.\n"
"\\end{expansion}\n"
"\n"

#. type: multicols*
#: sections/map_elements.tex:192 sections/map_elements.tex:202
