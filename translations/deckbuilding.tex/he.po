#. type: multicols
#: sections/deckbuilding.tex:298
#, no-wrap
msgid ""
"Additional Spell rules:\\par\n"
"\\begin{itemize}\n"
"    \\item You may use a cheaper effect than the \\svg{empower} you paid for.\n"
"    \\item You may resolve cards with +\\svg{empower} effects (e.g. \\wikilink{abilities/sorcery}{Sorcery}) before deciding which Spell to cast.\n"
"    \\item During Combat, each player may play \\textbf{only one Spell card per Combat Round} for its primary effect.\n"
"    Some effects, such as \\svg{expert} \\wikilink{statistics/knowledge}{Knowledge,} increase this limit.\n"
"    \\columnbreak\n"
"    \\item When you use an effect that lets you cast a Spell from outside your hand (such as directly from the Spell Deck), place that Spell into your Discard Pile after casting~it.\n"
"    These Spells also count against your Combat Round Spell limit.\n"
"    \\item Some Spell cards with complex effects use keywords or require special components; see \\pagelink{spell keywords}{Card Effect Keywords}.\n"
"    \\item Spells can be \\pagelink{Trading}{traded} in Alliance and Cooperative Scenarios.\n"
"\\end{itemize}\n"
"\n"
msgstr ""
"כללים נוספים לקסמים:\\par\n"
"\\begin{itemize}\n"
"    \\item תוכלו להשתמש באפקט זול יותר מכמות ה-\\svg{empower} ששילמתם.\n"
"    \\item תוכלו להפעיל קלפים עם אפקטי \\textenglish{+}\\svg{empower} (למשל \\wikilink{abilities/sorcery}{\\texthebrew{\\textenglish{Sorcery} (כישוף)}}) לפני שתחליטו איזה קסם להטיל.\n"
"    \\item במהלך קרב, כל שחקן יכול לשחק \\textbf{רק קלף קסם אחד בכל סבב קרב} עבור האפקט הראשי שלו.\n"
"    אפקטים מסוימים, כמו אפקט ה-\\svg{expert} של \\wikilink{statistics/knowledge}{\\texthebrew{\\textenglish{Knowledge} (ידע)}}, מגדילים מגבלה זו.\n"
"    \\columnbreak\n"
"    \\item כשאתם משתמשים באפקט שמאפשר לכם להטיל קסם שאינו מהיד שלכם (למשל ישירות מחפיסת הקסמים), הניחו את הקסם בערימת ההשלכה שלכם לאחר שהטלתם~אותו.\n"
"    גם קסמים אלה נספרים במגבלת הקסמים שלכם בסבב הקרב.\n"
"    \\item חלק מקלפי הקסם בעלי האפקטים המורכבים משתמשים במילות מפתח או דורשים רכיבים מיוחדים; ראו \\pagelink{spell keywords}{מילות מפתח של אפקטי קלפים}.\n"
"    \\item בתרחישי ברית ובתרחישים שיתופיים תוכלו \\pagelink{Trading}{לסחור} בקסמים.\n"
"\\end{itemize}\n"
"\n"

