"        \\draw (0.6, 0.92) node {\\encircle{1}};\n"
"        \\draw (0.5, 0.15) node {\\encircle{2}};\n"
"        \\draw (0.3, 0.3) node {\\encircle{3}};\n"
"        \\draw (0.7, 0.3) node {\\encircle{4}};\n"
"      \\end{relcoords}\n"
"    \\end{tikzpicture}\n"
"\n"
"    \\medskip\n"
"    \\footnotesize\n"
"    \\imagecaption{Carte Machine de guerre}\n"
"    \\begin{itemize}[itemsep=0pt, parsep=5pt, topsep=0pt, partopsep=0pt]\n"
"      \\item[\\textbf{1.}] Nom\n"
"      \\item[\\textbf{2.}] Effet\n"
"      \\item[\\textbf{3.}] Coût en Manufacture d’armes\n"
"      \\item[\\textbf{4.}] Coût au Comptoir\n"
"    \\end{itemize}\n"
"  }"
