#. type: multicols
#: sections/card_effect_keywords.tex:95
#, no-wrap
msgid ""
"\\vspace*{1em}\n"
"\\begin{expansion}{battlefield,conflux}\n"
"  \\pagetarget{Fire Wall Token}{\\subsection*{Fire Wall Token}}\n"
"  \\index{Fire Wall}\n"
"  The \\wikilink{spells/fire_wall}{\\textbf{Fire Wall Spell}} and \\wikilink{heroes/luna\\#specialty}{\\textbf{Luna's Specialty cards I and VI}} instruct you to place the Fire Wall card onto a space on the Combat Board.\n"
"  You may use the Fire Wall Tokens instead of the cards.\n"
"  Place the Spell or Specialty card next to the Combat Board as a reminder.\n"
"  When the card is removed or discarded, discard the Token as well.\n"
"  When using the large \\pagelink{Battlefield Combat}{Battlefield Board}, you must use the Token instead of the card.\n"
"\n"
msgstr ""
"\\vspace*{1em}\n"
"\\begin{expansion}{battlefield,conflux}\n"
"  \\pagetarget{Fire Wall Token}{\\subsection*{אסימון חומת אש}}\n"
"  \\index{חומת אש}\n"
"  הקסם \\wikilink{spells/fire_wall}{\\texthebrew{\\textbf{\\textenglish{Fire Wall}} (חומת אש)}} ו\\wikilink{heroes/luna\\#specialty}{\\texthebrew{\\textbf{קלפי המומחיות \\textenglish{I} ו-\\textenglish{VI} של \\textenglish{Luna}}}} מורים לכם להניח את קלף חומת האש על משבצת בלוח הקרב.\n"
"  אתם רשאים להשתמש באסימוני חומת האש במקום בקלפים.\n"
"  הניחו את קלף הקסם או את קלף המומחיות ליד לוח הקרב כתזכורת.\n"
"  כשאתם מסירים או משליכים את הקלף, השליכו גם את האסימון.\n"
"  כשאתם משחקים על \\pagelink{Battlefield Combat}{לוח שדה הקרב} הגדול, אתם חייבים להשתמש באסימון במקום בקלף.\n"
"\n"

