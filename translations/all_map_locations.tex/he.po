"\\end{center}\n"
"\n"

#. type: multicols
#: sections/all_map_locations.tex:264
#, no-wrap
msgid ""
"\\pagetarget{Mines}{\\subheader{Mines}}\n"
"{\\textbf{Mines}}\\index{Mines} are flaggable Fields which increase a specific resource's income when flagged.\n"
"If you are the first one to flag a mine, it also immediately provides you with its income.\n"
"All mines have the \\svg{ongoing} symbol and a picture of the Resource they produce next to it.\n"
"\n"
msgstr ""
"\\pagetarget{Mines}{\\subheader{מכרות}}\n"
"{\\textbf{מכרות}}\\index{מכרות} הם שדות הניתנים לכיבוש, וכשאתם כובשים אותם הם מגדילים את ההכנסה שלכם ממשאב מסוים.\n"
"אם אתם הראשונים שכובשים מכרה, הוא גם מעניק לכם מיד את ההכנסה שלו.\n"
"על כל המכרות מופיע הסמל \\svg{ongoing}, ולידו תמונה של המשאב שהם מייצרים.\n"
"\n"

#. type: multicols
#: sections/all_map_locations.tex:270
#, no-wrap
msgid ""
"\\begin{center}\n"
"  \\includegraphics[width=0.55\\linewidth]{\\images/mine_example.png}\\\\\n"
"  \\textit{A mine that produces \\svg{valuables}, guarded by \\mbox{Level III} Neutral Units.\n"
"    The first player to flag this Field would immediately gain one \\svg{valuables} in addition to increasing their \\svg{valuables} income.\n"
"  }\n"
"\n"
msgstr ""
"\\begin{center}\n"
"  \\includegraphics[width=0.55\\linewidth]{\\images/mine_example.png}\\\\\n"
"  \\textit{מכרה שמייצר \\svg{valuables}, ויחידות נייטרליות \\mbox{ברמה \\textenglish{III}} שומרות עליו.\n"
"    השחקן הראשון שיכבוש את השדה יקבל מיד \\svg{valuables} אחד, וגם יגדיל את ההכנסה שלו מ-\\svg{valuables}.\n"
"  }\n"
"\n"

#. type: multicols
#: sections/all_map_locations.tex:275
#, no-wrap
msgid ""
"  \\vspace*{\\fill}\n"
"  \\framedimage[\\linewidth]{\\map_locations/ore-gold-mine.jpg}\n"
"  \\textit{\\svg{building_materials} and \\svg{gold} mines.}\n"
"\\end{center}"
msgstr ""
"  \\vspace*{\\fill}\n"
"  \\framedimage[\\linewidth]{\\map_locations/ore-gold-mine.jpg}\n"
"  \\textit{מכרות \\svg{building_materials} ו-\\svg{gold}.}\n"
"\\end{center}"

#. type: center
