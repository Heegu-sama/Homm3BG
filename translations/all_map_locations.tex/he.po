#. type: multicols
#: sections/all_map_locations.tex:314
#, no-wrap
msgid ""
"\\begin{expansion}[before=\\vspace*{-11mm}]{inferno,stretchgoals2}\n"
"  \\pagetarget{Random Town}{\\subsection*{Random Town}}\n"
"  \\index{Random Town}\n"
"  \\framedimage[\\linewidth]{\\map_locations/random_town.jpg}\n"
"\n"
msgstr ""
"\\begin{expansion}[before=\\vspace*{-11mm}]{inferno,stretchgoals2}\n"
"  \\pagetarget{Random Town}{\\subsection*{עיר אקראית}}\n"
"  \\index{עיר אקראית}\n"
"  \\framedimage[\\linewidth]{\\map_locations/random_town.jpg}\n"
"\n"

#. type: multicols
#: sections/all_map_locations.tex:324
#, no-wrap
msgid ""
"  \\medskip\n"
"  When revealed, choose a Faction not in play. Either:\n"
"  \\begin{itemize}\n"
"    \\item All players roll 2 \\svg{resource_die}.\n"
"      The highest roller chooses, OR\n"
"    \\begin{expansion}[left=5mm]{stretchgoals2}\n"
"    \\item Draw a random \\pagelink{Town Card}{Town Card}.\n"
"    \\end{expansion}\n"
"  \\end{itemize}\n"
"\n"
msgstr ""
"  \\medskip\n"
"  כשהעיר נחשפת, בחרו סיעה שלא משתתפת במשחק, באחת הדרכים הבאות:\n"
"  \\begin{itemize}\n"
"    \\item כל השחקנים מטילים \\textenglish{2} \\svg{resource_die}.\n"
"      מי שקיבל את התוצאה הגבוהה ביותר בוחר, או\n"
"    \\begin{expansion}[left=5mm]{stretchgoals2}\n"
"    \\item שלפו \\pagelink{Town Card}{קלף עיר} אקראי.\n"
"    \\end{expansion}\n"
"  \\end{itemize}\n"
"\n"

#. type: multicols
#: sections/all_map_locations.tex:334
#, no-wrap
msgid ""
"  The Random Town is defended by units from that Faction:\n"
"  \\begin{itemize}\n"
"    \\item a ``Pack'' of \\svg{bronze} units, chosen by the player who controls the defense during this Combat,\n"
"    \\item two ``Packs'' of \\svg{silver} units,\n"
"    \\item two ``Fews'' of \\svg{golden} units.\n"
"  \\end{itemize}\n"
"  Add \\pagelink{Walls}{Walls and the Gate} for this Combat, but not the Arrow Tower.\n"
"  Flagging the Random Town increases \\svg{gold} production by 10, which is also gained immediately if you are the first to flag it.\n"
"  While you have the Random Town flagged, treat it as a Settlement.\n"
"\n"
msgstr ""
"  יחידות מאותה סיעה מגינות על העיר האקראית:\n"
"  \\begin{itemize}\n"
"    \\item ״רבים״ של יחידות \\svg{bronze}, שבוחר השחקן ששולט בהגנה בקרב הזה,\n"
"    \\item שני ״רבים״ של יחידות \\svg{silver},\n"
"    \\item שני ״מעטים״ של יחידות \\svg{golden}.\n"
"  \\end{itemize}\n"
"  הוסיפו לקרב הזה \\pagelink{Walls}{חומות ושער}, אבל לא את מגדל החצים.\n"
"  כיבוש העיר האקראית מגדיל את ייצור ה-\\svg{gold} ב-\\textenglish{10}. אם אתם הראשונים שכובשים אותה, אתם גם מקבלים את הסכום הזה מיד.\n"
"  כל עוד העיר האקראית כבושה בידיכם, התייחסו אליה כאל יישוב.\n"
"\n"

#. type: multicols
#: sections/all_map_locations.tex:338
#, no-wrap
msgid ""
"  \\medskip\n"
"  \\textbf{Note:} Tiles with the Random Town can be used only if there is at least one unused Faction in the game.\n"
"\\end{expansion}\n"
"\n"
msgstr ""
"  \\medskip\n"
"  \\textbf{שימו לב:} אפשר להשתמש באריחים עם העיר האקראית רק אם יש במשחק לפחות סיעה אחת שאינה בשימוש.\n"
"\\end{expansion}\n"
"\n"

