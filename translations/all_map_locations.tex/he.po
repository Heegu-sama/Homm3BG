msgstr "\\framedimage[\\linewidth]{\\map_locations/expansion_towns.png}"

#. type: center
#: sections/all_map_locations.tex:283
msgid ""
"\\textit{Towns from expansions:\\\\Conflux, Stronghold, Cove, Tower, "
"Rampart, Fortress, and Inferno.}"
msgstr ""
